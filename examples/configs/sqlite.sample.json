{
  "databases": {
    "sqlite": {
      "default": {
        "primary": {
          "file_path": "./data/app.db",
          "session_settings": {
            "foreign_keys": true,
            "journal_mode": "WAL",
            "busy_timeout": 5000
          },
          "engine_options": {
            "pool_pre_ping": true
          }
        },
        "replica": {
          "file_path": "./data/app-replica.db",
          "session_settings": {
            "foreign_keys": true,
            "busy_timeout": 5000
          },
          "engine_options": {
            "pool_pre_ping": true
          }
        }
      }
    }
  }
}
