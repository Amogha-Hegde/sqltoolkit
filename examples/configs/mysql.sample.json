{
  "databases": {
    "mysql": {
      "default": {
        "primary": {
          "db_url": "mysql+pymysql://app_user:secret@localhost:3306/app",
          "database_options": {
            "charset": "utf8mb4"
          },
          "session_settings": {
            "sql_mode": "STRICT_ALL_TABLES",
            "time_zone": "+00:00",
            "innodb_lock_wait_timeout": 10,
            "max_execution_time": 5000
          },
          "engine_options": {
            "pool_size": 10,
            "max_overflow": 20,
            "pool_pre_ping": true,
            "pool_recycle": 1800
          }
        },
        "replica": {
          "db_url": "mysql+pymysql://replica_user:secret@localhost:3306/app",
          "database_options": {
            "charset": "utf8mb4"
          },
          "session_settings": {
            "sql_mode": "STRICT_ALL_TABLES",
            "time_zone": "+00:00",
            "transaction_read_only": 1
          },
          "engine_options": {
            "pool_size": 5,
            "max_overflow": 10,
            "pool_pre_ping": true
          }
        }
      }
    }
  }
}
