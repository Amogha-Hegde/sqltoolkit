# Oracle env-sample sample for sqltoolkit.
# Structured fields can be used instead of a raw DB URL.
# - SESSION_SETTINGS: ALTER SESSION SET ... statements
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

SQLTOOLKIT__ORACLE__DEFAULT__READWRITE__USERNAME=app_user
SQLTOOLKIT__ORACLE__DEFAULT__READWRITE__PASSWORD=secret
SQLTOOLKIT__ORACLE__DEFAULT__READWRITE__HOST=localhost
SQLTOOLKIT__ORACLE__DEFAULT__READWRITE__PORT=1521
SQLTOOLKIT__ORACLE__DEFAULT__READWRITE__SERVICE_NAME=FREEPDB1
SQLTOOLKIT__ORACLE__DEFAULT__READWRITE__SESSION_SETTINGS={"time_zone":"UTC","nls_date_format":"YYYY-MM-DD","nls_timestamp_format":"YYYY-MM-DD HH24:MI:SS"}
SQLTOOLKIT__ORACLE__DEFAULT__READWRITE__ENGINE_OPTIONS={"pool_size":10,"max_overflow":20,"pool_pre_ping":true}

SQLTOOLKIT__ORACLE__DEFAULT__READONLY__USERNAME=readonly_user
SQLTOOLKIT__ORACLE__DEFAULT__READONLY__PASSWORD=secret
SQLTOOLKIT__ORACLE__DEFAULT__READONLY__HOST=localhost
SQLTOOLKIT__ORACLE__DEFAULT__READONLY__PORT=1521
SQLTOOLKIT__ORACLE__DEFAULT__READONLY__SERVICE_NAME=FREEPDB1
SQLTOOLKIT__ORACLE__DEFAULT__READONLY__SESSION_SETTINGS={"time_zone":"UTC","nls_date_format":"YYYY-MM-DD"}
SQLTOOLKIT__ORACLE__DEFAULT__READONLY__ENGINE_OPTIONS={"pool_size":5,"max_overflow":10,"pool_pre_ping":true}
