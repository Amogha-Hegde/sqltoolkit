# Oracle env-sample sample for sqltoolkit.
# Structured fields can be used instead of a raw DB URL.
# - SESSION_SETTINGS: ALTER SESSION SET ... statements
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

SQLTOOLKIT__ORACLE__DEFAULT__PRIMARY__USERNAME=app_user
SQLTOOLKIT__ORACLE__DEFAULT__PRIMARY__PASSWORD=secret
SQLTOOLKIT__ORACLE__DEFAULT__PRIMARY__HOST=localhost
SQLTOOLKIT__ORACLE__DEFAULT__PRIMARY__PORT=1521
SQLTOOLKIT__ORACLE__DEFAULT__PRIMARY__SERVICE_NAME=FREEPDB1
SQLTOOLKIT__ORACLE__DEFAULT__PRIMARY__SESSION_SETTINGS={"time_zone":"UTC","nls_date_format":"YYYY-MM-DD","nls_timestamp_format":"YYYY-MM-DD HH24:MI:SS"}
SQLTOOLKIT__ORACLE__DEFAULT__PRIMARY__ENGINE_OPTIONS={"pool_size":10,"max_overflow":20,"pool_pre_ping":true}

SQLTOOLKIT__ORACLE__DEFAULT__REPLICA__USERNAME=replica_user
SQLTOOLKIT__ORACLE__DEFAULT__REPLICA__PASSWORD=secret
SQLTOOLKIT__ORACLE__DEFAULT__REPLICA__HOST=localhost
SQLTOOLKIT__ORACLE__DEFAULT__REPLICA__PORT=1521
SQLTOOLKIT__ORACLE__DEFAULT__REPLICA__SERVICE_NAME=FREEPDB1
SQLTOOLKIT__ORACLE__DEFAULT__REPLICA__SESSION_SETTINGS={"time_zone":"UTC","nls_date_format":"YYYY-MM-DD"}
SQLTOOLKIT__ORACLE__DEFAULT__REPLICA__ENGINE_OPTIONS={"pool_size":5,"max_overflow":10,"pool_pre_ping":true}
