# Oracle env-sample sample for sqltoolkit.
# Structured fields can be used instead of a raw DB URL.
# - SESSION_SETTINGS: ALTER SESSION SET ... statements
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

# Shared registry failure backoff settings
SQLTOOLKIT_FAILURE_BACKEND=memory
SQLTOOLKIT_REGISTRY_FAILURE_TTL=5
# Set SQLTOOLKIT_FAILURE_BACKEND=none to disable failure caching.

SQLTOOLKIT_ORACLE_PRIMARY_USERNAME=app_user
SQLTOOLKIT_ORACLE_PRIMARY_PASSWORD=secret
SQLTOOLKIT_ORACLE_PRIMARY_HOST=localhost
SQLTOOLKIT_ORACLE_PRIMARY_PORT=1521
SQLTOOLKIT_ORACLE_PRIMARY_SERVICE_NAME=FREEPDB1
SQLTOOLKIT_ORACLE_PRIMARY_SESSION_SETTINGS={"time_zone":"UTC","nls_date_format":"YYYY-MM-DD","nls_timestamp_format":"YYYY-MM-DD HH24:MI:SS"}
SQLTOOLKIT_ORACLE_PRIMARY_ENGINE_OPTIONS={"pool_size":10,"max_overflow":20,"pool_pre_ping":true}

SQLTOOLKIT_ORACLE_REPLICA_USERNAME=replica_user
SQLTOOLKIT_ORACLE_REPLICA_PASSWORD=secret
SQLTOOLKIT_ORACLE_REPLICA_HOST=localhost
SQLTOOLKIT_ORACLE_REPLICA_PORT=1521
SQLTOOLKIT_ORACLE_REPLICA_SERVICE_NAME=FREEPDB1
SQLTOOLKIT_ORACLE_REPLICA_SESSION_SETTINGS={"time_zone":"UTC","nls_date_format":"YYYY-MM-DD"}
SQLTOOLKIT_ORACLE_REPLICA_ENGINE_OPTIONS={"pool_size":5,"max_overflow":10,"pool_pre_ping":true}
