# Oracle env-sample sample for sqltoolkit.
# Structured fields can be used instead of a raw DB URL.
# - SESSION_SETTINGS: ALTER SESSION SET ... statements
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

# Shared registry failure backoff settings
SQLTOOLKIT_FAILURE_BACKEND=memory
SQLTOOLKIT_REGISTRY_FAILURE_TTL=5
# Set SQLTOOLKIT_FAILURE_BACKEND=none to disable failure caching.

SQLTOOLKIT__ORACLE__PRIMARY__USERNAME=app_user
SQLTOOLKIT__ORACLE__PRIMARY__PASSWORD=secret
SQLTOOLKIT__ORACLE__PRIMARY__HOST=localhost
SQLTOOLKIT__ORACLE__PRIMARY__PORT=1521
SQLTOOLKIT__ORACLE__PRIMARY__SERVICE_NAME=FREEPDB1
SQLTOOLKIT__ORACLE__PRIMARY__SESSION_SETTINGS={"time_zone":"UTC","nls_date_format":"YYYY-MM-DD","nls_timestamp_format":"YYYY-MM-DD HH24:MI:SS"}
SQLTOOLKIT__ORACLE__PRIMARY__ENGINE_OPTIONS={"pool_size":10,"max_overflow":20,"pool_pre_ping":true}

SQLTOOLKIT__ORACLE__REPLICA__USERNAME=replica_user
SQLTOOLKIT__ORACLE__REPLICA__PASSWORD=secret
SQLTOOLKIT__ORACLE__REPLICA__HOST=localhost
SQLTOOLKIT__ORACLE__REPLICA__PORT=1521
SQLTOOLKIT__ORACLE__REPLICA__SERVICE_NAME=FREEPDB1
SQLTOOLKIT__ORACLE__REPLICA__SESSION_SETTINGS={"time_zone":"UTC","nls_date_format":"YYYY-MM-DD"}
SQLTOOLKIT__ORACLE__REPLICA__ENGINE_OPTIONS={"pool_size":5,"max_overflow":10,"pool_pre_ping":true}
