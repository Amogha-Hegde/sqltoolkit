# PostgreSQL env-sample sample for sqltoolkit.
# Prefix format:
# SQLTOOLKIT__{DIALECT}__{TENANT}__{ACCESS_MODE}__{KEY}
#
# Buckets:
# - DATABASE_OPTIONS: connection URL/query parameters
# - SESSION_SETTINGS: per-connection PostgreSQL settings
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

SQLTOOLKIT__POSTGRESQL__DEFAULT__READWRITE__DB_URL=postgresql+psycopg://app_user:secret@localhost:5432/app
SQLTOOLKIT__POSTGRESQL__DEFAULT__READWRITE__DATABASE_OPTIONS={"application_name":"sqltoolkit"}
SQLTOOLKIT__POSTGRESQL__DEFAULT__READWRITE__SESSION_SETTINGS={"search_path":"app, public","statement_timeout":"30000","lock_timeout":"5000","idle_in_transaction_session_timeout":"60000","deadlock_timeout":"1000","default_transaction_isolation":"read committed","default_transaction_read_only":false,"default_transaction_deferrable":false,"jit":false,"max_parallel_workers_per_gather":2,"work_mem":"64MB","maintenance_work_mem":"256MB","random_page_cost":1.1,"effective_cache_size":"4GB","log_min_duration_statement":250,"TimeZone":"UTC","DateStyle":"ISO, MDY","row_security":true}
SQLTOOLKIT__POSTGRESQL__DEFAULT__READWRITE__ENGINE_OPTIONS={"pool_size":10,"max_overflow":20,"pool_pre_ping":true,"pool_recycle":1800,"pool_use_lifo":true}

SQLTOOLKIT__POSTGRESQL__DEFAULT__READONLY__DB_URL=postgresql+psycopg://readonly_user:secret@localhost:5432/app
SQLTOOLKIT__POSTGRESQL__DEFAULT__READONLY__DATABASE_OPTIONS={"application_name":"sqltoolkit-readonly"}
SQLTOOLKIT__POSTGRESQL__DEFAULT__READONLY__SESSION_SETTINGS={"search_path":"app, public","statement_timeout":"15000","default_transaction_read_only":true,"TimeZone":"UTC"}
SQLTOOLKIT__POSTGRESQL__DEFAULT__READONLY__ENGINE_OPTIONS={"pool_size":5,"max_overflow":10,"pool_pre_ping":true}
