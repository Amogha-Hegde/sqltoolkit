# SQLite env-sample sample for sqltoolkit.
# - SESSION_SETTINGS: PRAGMA statements on connect
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

# Shared registry failure backoff settings
SQLTOOLKIT_FAILURE_BACKEND=memory
SQLTOOLKIT_REGISTRY_FAILURE_TTL=5
# Set to "none" to disable failure caching.

SQLTOOLKIT_SQLITE_PRIMARY_FILE_PATH=./data/app.db
SQLTOOLKIT_SQLITE_PRIMARY_SESSION_SETTINGS={"foreign_keys":true,"journal_mode":"WAL","busy_timeout":5000}
SQLTOOLKIT_SQLITE_PRIMARY_ENGINE_OPTIONS={"pool_pre_ping":true}

SQLTOOLKIT_SQLITE_REPLICA_FILE_PATH=./data/app-replica.db
SQLTOOLKIT_SQLITE_REPLICA_SESSION_SETTINGS={"foreign_keys":true,"busy_timeout":5000}
SQLTOOLKIT_SQLITE_REPLICA_ENGINE_OPTIONS={"pool_pre_ping":true}
