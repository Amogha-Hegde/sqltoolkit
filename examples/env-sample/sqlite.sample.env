# SQLite env-sample sample for sqltoolkit.
# - SESSION_SETTINGS: PRAGMA statements on connect
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

SQLTOOLKIT__SQLITE__PRIMARY__FILE_PATH=./data/app.db
SQLTOOLKIT__SQLITE__PRIMARY__SESSION_SETTINGS={"foreign_keys":true,"journal_mode":"WAL","busy_timeout":5000}
SQLTOOLKIT__SQLITE__PRIMARY__ENGINE_OPTIONS={"pool_pre_ping":true}

SQLTOOLKIT__SQLITE__REPLICA__FILE_PATH=./data/app-replica.db
SQLTOOLKIT__SQLITE__REPLICA__SESSION_SETTINGS={"foreign_keys":true,"busy_timeout":5000}
SQLTOOLKIT__SQLITE__REPLICA__ENGINE_OPTIONS={"pool_pre_ping":true}
