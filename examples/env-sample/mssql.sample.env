# MSSQL env-sample sample for sqltoolkit.
# - SESSION_SETTINGS: SET ... statements on connect
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

# Shared registry failure backoff settings
SQLTOOLKIT_FAILURE_BACKEND=memory
SQLTOOLKIT_REGISTRY_FAILURE_TTL=5
# For Redis-backed shared failures, install sqltoolkit[redis] and uncomment:
# SQLTOOLKIT_FAILURE_BACKEND=redis
# SQLTOOLKIT_REDIS_URL=redis://localhost:6379/0
# SQLTOOLKIT_REDIS_FAILURE_PREFIX=sqltoolkit:failures

SQLTOOLKIT__MSSQL__PRIMARY__DB_URL=mssql+pyodbc://app_user:secret@localhost:1433/app?driver=ODBC+Driver+18+for+SQL+Server
SQLTOOLKIT__MSSQL__PRIMARY__SESSION_SETTINGS={"LOCK_TIMEOUT":5000,"XACT_ABORT":true,"TRANSACTION ISOLATION LEVEL":"READ COMMITTED"}
SQLTOOLKIT__MSSQL__PRIMARY__ENGINE_OPTIONS={"pool_size":10,"max_overflow":20,"pool_pre_ping":true}

SQLTOOLKIT__MSSQL__REPLICA__DB_URL=mssql+pyodbc://replica_user:secret@localhost:1433/app?driver=ODBC+Driver+18+for+SQL+Server
SQLTOOLKIT__MSSQL__REPLICA__SESSION_SETTINGS={"LOCK_TIMEOUT":5000,"XACT_ABORT":true,"TRANSACTION ISOLATION LEVEL":"READ UNCOMMITTED"}
SQLTOOLKIT__MSSQL__REPLICA__ENGINE_OPTIONS={"pool_size":5,"max_overflow":10,"pool_pre_ping":true}
