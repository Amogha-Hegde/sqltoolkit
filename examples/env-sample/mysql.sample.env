# MySQL env-sample sample for sqltoolkit.
# - DATABASE_OPTIONS: connection URL/query parameters such as charset
# - SESSION_SETTINGS: MySQL session variables
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

# Shared registry failure backoff settings
SQLTOOLKIT_FAILURE_BACKEND=memory
SQLTOOLKIT_REGISTRY_FAILURE_TTL=5
# Set SQLTOOLKIT_FAILURE_BACKEND=none to disable failure caching.

SQLTOOLKIT_MYSQL_PRIMARY_DB_URL=mysql+pymysql://app_user:secret@localhost:3306/app
SQLTOOLKIT_MYSQL_PRIMARY_DATABASE_OPTIONS={"charset":"utf8mb4"}
SQLTOOLKIT_MYSQL_PRIMARY_SESSION_SETTINGS={"sql_mode":"STRICT_ALL_TABLES","time_zone":"+00:00","innodb_lock_wait_timeout":10,"max_execution_time":5000}
SQLTOOLKIT_MYSQL_PRIMARY_ENGINE_OPTIONS={"pool_size":10,"max_overflow":20,"pool_pre_ping":true,"pool_recycle":1800}

SQLTOOLKIT_MYSQL_REPLICA_DB_URL=mysql+pymysql://replica_user:secret@localhost:3306/app
SQLTOOLKIT_MYSQL_REPLICA_DATABASE_OPTIONS={"charset":"utf8mb4"}
SQLTOOLKIT_MYSQL_REPLICA_SESSION_SETTINGS={"sql_mode":"STRICT_ALL_TABLES","time_zone":"+00:00","transaction_read_only":1}
SQLTOOLKIT_MYSQL_REPLICA_ENGINE_OPTIONS={"pool_size":5,"max_overflow":10,"pool_pre_ping":true}
