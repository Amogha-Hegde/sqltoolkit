# MySQL env-sample sample for sqltoolkit.
# - DATABASE_OPTIONS: connection URL/query parameters such as charset
# - SESSION_SETTINGS: MySQL session variables
# - ENGINE_OPTIONS: SQLAlchemy engine/pool kwargs

# Shared registry failure backoff settings
SQLTOOLKIT_FAILURE_BACKEND=memory
SQLTOOLKIT_REGISTRY_FAILURE_TTL=5
# For Redis-backed shared failures, install sqltoolkit[redis] and uncomment:
# SQLTOOLKIT_FAILURE_BACKEND=redis
# SQLTOOLKIT_REDIS_URL=redis://localhost:6379/0
# SQLTOOLKIT_REDIS_FAILURE_PREFIX=sqltoolkit:failures

SQLTOOLKIT__MYSQL__PRIMARY__DB_URL=mysql+pymysql://app_user:secret@localhost:3306/app
SQLTOOLKIT__MYSQL__PRIMARY__DATABASE_OPTIONS={"charset":"utf8mb4"}
SQLTOOLKIT__MYSQL__PRIMARY__SESSION_SETTINGS={"sql_mode":"STRICT_ALL_TABLES","time_zone":"+00:00","innodb_lock_wait_timeout":10,"max_execution_time":5000}
SQLTOOLKIT__MYSQL__PRIMARY__ENGINE_OPTIONS={"pool_size":10,"max_overflow":20,"pool_pre_ping":true,"pool_recycle":1800}

SQLTOOLKIT__MYSQL__REPLICA__DB_URL=mysql+pymysql://replica_user:secret@localhost:3306/app
SQLTOOLKIT__MYSQL__REPLICA__DATABASE_OPTIONS={"charset":"utf8mb4"}
SQLTOOLKIT__MYSQL__REPLICA__SESSION_SETTINGS={"sql_mode":"STRICT_ALL_TABLES","time_zone":"+00:00","transaction_read_only":1}
SQLTOOLKIT__MYSQL__REPLICA__ENGINE_OPTIONS={"pool_size":5,"max_overflow":10,"pool_pre_ping":true}
